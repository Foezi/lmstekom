# Database PostgreSQL lokal
DATABASE_URL="postgresql://postgres:psg214@localhost:5432/lms_simtugas"

# Server
PORT=3000

# JWT — ganti dengan secret acak yang kuat di production
JWT_SECRET="ganti-dengan-secret-acak-yang-kuat"
JWT_EXPIRES_IN="12h"

# OTP stub: bila true, kode OTP dikembalikan di response API & dicetak ke console (dev only)
OTP_DEV_MODE=true
OTP_TTL_MINUTES=10
